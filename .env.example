# Leave empty to run in retrieval-only mode (no LLM calls, no cost).
# Set your own key to get full answers and decision/action-item extraction.
ANTHROPIC_API_KEY=

DATABASE_URL=postgres://meetings:meetings@localhost:5432/meetings

# Password for the compose db service. The default is for local use only; set your own anywhere else.
POSTGRES_PASSWORD=meetings

# Voice transcription. Compose sets VOICE_MODELS_DIR itself (the models are baked into the image).
# Outside Docker, leave it unset to turn voice off, or point it at a directory laid out as in apps/api/Dockerfile.
# VOICE_MODELS_DIR=
# VOICE_MAX_SECONDS=1800
# VOICE_THREADS=2
# VOICE_MAX_QUEUE=4
