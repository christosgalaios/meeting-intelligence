{
  "name": "@meeting-intelligence/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs src/db/migrate-cli.ts",
    "seed": "node --env-file-if-exists=../../.env ../../node_modules/tsx/dist/cli.mjs seed/seed-cli.ts",
    "eval": "node ../../node_modules/tsx/dist/cli.mjs scripts/eval.ts",
    "voice:eval": "node ../../node_modules/tsx/dist/cli.mjs scripts/voice-eval.ts",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --coverage",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "node ../../node_modules/eslint/bin/eslint.js ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@huggingface/transformers": "^4.3.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sherpa-onnx-node": "2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
